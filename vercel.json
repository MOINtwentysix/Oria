{
  "buildCommand": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 NODE_OPTIONS='--max-old-space-size=4096' npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon.ico|metadata.json|.*\\.).*)",
      "destination": "/"
    }
  ],
  "env": {
    "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
  }
}
