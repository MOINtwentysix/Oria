# ==========================================
# Oria — Environment Configuration
# ==========================================

# ------------------------------------------
# Frontend (Expo / React Native)
# ------------------------------------------
# Mistral AI API Key for Oria AI assistant (mistral-small-latest)
# Holt man sich unter: https://console.mistral.ai/
EXPO_PUBLIC_MISTRAL_API_KEY=your_mistral_api_key_here

# Backend API URL (Optional in local dev, defaults to http://localhost:3001)
# EXPO_PUBLIC_BACKEND_URL=https://oria-api.moin26.dev

# Clerk Auth Publishable Key (Optional, App funktioniert auch ohne)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------
# Backend (server/ oder Vercel API)
# ------------------------------------------
# Mistral API Key für Backend-Endpunkte
MISTRAL_API_KEY=your_mistral_api_key_here

# Neon PostgreSQL Database URL
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/oria?sslmode=require

# Server Port (Standard: 3001)
PORT=3001
