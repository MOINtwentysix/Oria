{
  "expo": {
    "name": "Oria",
    "slug": "oria",
    "version": "1.0.0-beta-1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oria.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Oria needs your location to show nearby places and calculate routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Oria needs your location to show nearby places and calculate routes.",
        "NSCameraUsageDescription": "Oria needs camera access for profile photos.",
        "NSPhotoLibraryUsageDescription": "Oria needs photo library access for profile photos and place images.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.oria.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "oria",
    "extra": {
      "eas": {
        "projectId": "a00886a3-2a57-493b-844a-aef09f6225cf"
      }
    },
    "owner": "mointwentysix"
  }
}
