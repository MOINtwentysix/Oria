{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "memory": 4096,
  "timeout": 300,
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon.ico|metadata.json|.*\\.).*)",
      "destination": "/"
    }
  ]
}
