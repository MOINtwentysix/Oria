# Client: deployed Vercel API is used automatically on web. Set this for native builds.
EXPO_PUBLIC_API_URL=https://your-oria-domain.example/api

# Server-only Vercel environment variable. Never expose this in EXPO_PUBLIC_*.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional server-side override for the SSO userinfo endpoint.
SSO_USERINFO_URL=https://clerk.moin26.dev/oauth/userinfo

# Optional client-side AI configuration. Without a key Oria uses its local fallback.
EXPO_PUBLIC_MISTRAL_API_KEY=
EXPO_PUBLIC_MISTRAL_MODEL=mistral-small-latest
