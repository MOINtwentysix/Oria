{
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "cleanUrls": true,
  "env": {
    "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK": "1"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
