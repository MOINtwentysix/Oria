{
  "buildCommand": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon.ico|metadata.json|.*\\.).*)",
      "destination": "/"
    }
  ]
}
